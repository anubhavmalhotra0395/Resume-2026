# Doctavox all-in-one image: API + worker + Redis in one container.
# Torch-free: vocal separation runs Kim_Vocal_2.onnx via onnxruntime.
# The ~67 MB model downloads at first use into the /data volume.
# Target size ~1 GB (was ~2.5-3 GB with CPU torch, 14 GB with CUDA).
#
# Build:  docker build -f infra/Dockerfile.slim -t doctavox .
# Run:    docker run -p 7860:7860 -e GROQ_API_KEY=... -v dv-data:/data doctavox
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg redis-server \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-core.txt /app/
RUN pip install --no-cache-dir -r requirements-core.txt

COPY api /app/api
COPY processor /app/processor
# NOTE: both frontends live outside this image — frontend/ (the 3D room) and
# vocalforge/ (the Doctavox UI) deploy to Vercel and are not tracked here.
# api/main.py mounts /ui, /doctavox and /vocalforge only when those folders
# exist, so their absence is a no-op rather than an error.
COPY infra/start_all_in_one.sh /app/infra/start_all_in_one.sh
RUN chmod +x /app/infra/start_all_in_one.sh

# Writable dirs for hosts that run as non-root (uid 1000)
ENV APP_STORAGE_ROOT=/data \
    APP_REDIS_URL=redis://localhost:6379/0 \
    APP_ENABLE_WORKER=1 \
    XDG_CACHE_HOME=/data/cache \
    PORT=7860
RUN mkdir -p /data && chmod 777 /data /app

EXPOSE 7860
CMD ["/app/infra/start_all_in_one.sh"]
